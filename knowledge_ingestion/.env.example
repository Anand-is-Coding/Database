# =================================================
# AWS S3
# =================================================
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=yotutor-textbooks

# =================================================
# Qdrant
# =================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=yotutor_knowledge_base

# =================================================
# Embedding
# =================================================
EMBEDDING_MODEL=BAAI/bge-m3

# =================================================
# Parsing
# =================================================
# OCR is one of the heaviest parts of Docling's pipeline (memory + time).
# Set to false for digitally generated PDFs with a real text layer (most
# textbooks) - only scanned/image-only PDFs actually need OCR. Recommended
# false on machines with 8GB RAM or less.
DOCLING_DO_OCR=true
DOCLING_DO_TABLE_STRUCTURE=true
# Lower these (num_threads/batch_size to 1, image_scale to 0.75/0.5) if you
# hit std::bad_alloc crashes on memory-constrained machines.
DOCLING_NUM_THREADS=2
DOCLING_BATCH_SIZE=2
DOCLING_IMAGE_SCALE=1.0

# =================================================
# Generation (Q&A - ask.py)
# =================================================
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# =================================================
# Voice (ElevenLabs - voice_ask.py)
# =================================================
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Used when no subject is selected (or a subject has no entry below).
ELEVENLABS_DEFAULT_VOICE_ID=your-default-voice-id
# "Subject=voice_id;Subject Two=voice_id_2" - subject names must match your
# Qdrant collection names exactly (see the menu ask.py/voice_ask.py print).
ELEVENLABS_VOICE_MAP=Economics=voice_id_1;Mathematics=voice_id_2

# =================================================
# Logging
# =================================================
LOG_LEVEL=INFO
